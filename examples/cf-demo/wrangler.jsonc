{
  // Cloudflare Workers 上で動く公開デモ「リライングパーティ(OIDCクライアント)」。
  // デプロイ済みの tobirax2 IdP を指し、ブラウザのログインフローが端から端まで
  // (authorize -> token -> JWKS検証 -> userinfo)動くことを実証する。
  //
  // デプロイ:  npx wrangler deploy   (examples/cf-demo/ 内で実行)
  "name": "tobira-demo-rp",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-22",
  // サーバー間呼び出し(トークン交換・JWKS)は Worker->Worker で行う。同一アカウントの
  // 別 Worker の *.workers.dev へ直接 fetch するのは禁止されている(Cloudflare エラー 1042)
  // ため、これらはサービスバインディング経由でルーティングする。ブラウザ向けのリダイレクト
  // (/authorize, /oidc/logout)は下の公開 IDP_ISSUER URL を引き続き使う。
  "services": [{ "binding": "IDP", "service": "tobirax2" }],
  // バックチャネルログアウトの失効リスト(共有名前空間。キーは client_id でプレフィックス
  // するので、各 RP は自分のログアウト記録だけを読み書きする)。
  "kv_namespaces": [{ "binding": "BCL", "id": "a3ce2f0998d54da980ef39584e4558a8" }],
  "vars": {
    // デプロイ済みの tobirax2 IdP(末尾スラッシュなし)。
    "IDP_ISSUER": "https://tobirax2.tobira-sys.workers.dev",
    // IdP 管理画面で登録したアプリと一致させる(アプリ ID == client_id)。
    "CLIENT_ID": "cf-demo",
    // この Worker 自身の公開 URL == アプリの登録ベース URL。
    "APP_BASE_URL": "https://tobira-demo-rp.tobira-sys.workers.dev",
    // 表示用ラベル(2つのデモ RP を画面上で区別する)。
    "APP_NAME": "デモアプリ① (tobira-demo-rp)"
  }
  // シークレット(ここには保存しない — `wrangler secret put` で設定):
  //   CLIENT_SECRET  : IdP のアプリ編集モーダルに表示される機密クライアントのシークレット
  //   COOKIE_SECRET  : OIDC トランザクションCookieの署名に使うランダムなシークレット
  // 一度だけ次のように設定する:
  //   npx wrangler secret put CLIENT_SECRET -c examples/cf-demo/wrangler.jsonc
  //   npx wrangler secret put COOKIE_SECRET -c examples/cf-demo/wrangler.jsonc
}
