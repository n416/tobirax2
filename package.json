{
  "name": "tobira",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:client": "npx tsx scripts/build-client.ts",
    "db:check": "npx tsx scripts/check-db-sync.ts",
    "dev": "npm run db:check && concurrently -k -n client,server \"npx tsx scripts/build-client.ts --watch\" \"wrangler dev\"",
    "deploy": "npm run build:client && wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "setup:secrets": "npx tsx scripts/setup-secrets.ts",
    "demo:setup": "npx tsx scripts/setup-demo.ts",
    "db:clear": "npx tsx scripts/clear-db.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:client": "vitest run -c vitest.client.config.mts",
    "test:oidc": "vitest run test/oidc",
    "test:utils": "vitest run test/utils",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:csp": "vitest run --config vitest.integration.config.mts test/integration/csp-smoke.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "hono": "^4.11.1",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.18",
    "@cloudflare/workers-types": "^4.20240208.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.5",
    "concurrently": "^10.0.3",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.10.6",
    "typescript": "^5.0.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.56.0"
  }
}
